# Copy to server/.env for local development

PORT=5000
DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/DATABASE
JWT_SECRET=change-me-long-random-string

# --- Cloudflare R2 (required for audio, video, document uploads online) ---
# Dashboard: https://dash.cloudflare.com → R2 → Create bucket → Manage R2 API Tokens
S3_BUCKET=sermon-audio
S3_ACCESS_KEY_ID=your_r2_access_key_id
S3_SECRET_ACCESS_KEY=your_r2_secret_access_key
S3_REGION=auto
S3_ENDPOINT=https://7e7c5e484c61d5de19b902427130604f.r2.cloudflarestorage.com
S3_FORCE_PATH_STYLE=true

# Optional: if DATABASE_URL uses mysql.railway.internal (Render must use public URL)
# DATABASE_PUBLIC_URL=

MEMBER_PORTAL_URL=http://localhost:5173

# Optional email
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
