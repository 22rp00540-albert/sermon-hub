# Copy to server/.env for local development

PORT=5000
DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/DATABASE
JWT_SECRET=change-me-long-random-string

# Required for audio, video, and document uploads (Cloudflare R2, AWS S3, etc.)
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_FORCE_PATH_STYLE=true

# Optional: if DATABASE_URL uses mysql.railway.internal, set public URL here (Render)
# DATABASE_PUBLIC_URL=

# Optional email
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=

MEMBER_PORTAL_URL=http://localhost:5173
