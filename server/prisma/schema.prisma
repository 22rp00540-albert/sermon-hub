// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           Int         @id @default(autoincrement())
  fullName     String
  email        String      @unique
  passwordHash String
  country      String
  phoneNumber  String
  role         Role        @default(MEMBER)
  status       UserStatus  @default(PENDING)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  sermons      Sermon[]    @relation("UploadedSermons")
  videoSermons VideoSermon[] @relation("UploadedVideoSermons")
  listeningSessions ListeningSession[]
  videoListeningSessions VideoListeningSession[]
  passwordResetCodes PasswordResetCode[]
}

model Preacher {
  id        Int      @id @default(autoincrement())
  name      String
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sermons   Sermon[]
  videoSermons VideoSermon[]
}

model Sermon {
  id          Int      @id @default(autoincrement())
  title       String
  scripture   String
  description String?
  createdDate DateTime
  audioUrl    String
  documentUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  preacherId Int
  preacher   Preacher @relation(fields: [preacherId], references: [id], onDelete: Restrict)

  uploadedById Int
  uploadedBy   User @relation("UploadedSermons", fields: [uploadedById], references: [id], onDelete: Restrict)
  listeningSessions ListeningSession[]
  documents         SermonDocument[]
}

model VideoSermon {
  id          Int      @id @default(autoincrement())
  title       String
  scripture   String
  description String?
  createdDate DateTime
  videoUrl    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  preacherId Int
  preacher   Preacher @relation(fields: [preacherId], references: [id], onDelete: Restrict)

  uploadedById Int
  uploadedBy   User @relation("UploadedVideoSermons", fields: [uploadedById], references: [id], onDelete: Restrict)
  videoListeningSessions VideoListeningSession[]
}

model VideoListeningSession {
  id                     Int       @id @default(autoincrement())
  userId                 Int
  videoSermonId          Int
  progressSeconds        Int       @default(0)
  completed              Boolean   @default(false)
  completedAt            DateTime?
  /** Last known media length from the member player (seconds), used for % listened in admin reports. */
  mediaDurationSeconds   Int?
  updatedAt              DateTime  @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoSermon VideoSermon @relation(fields: [videoSermonId], references: [id], onDelete: Cascade)

  @@unique([userId, videoSermonId])
}

/// Singleton row (id = 1). Controls member-facing features.
model AppSettings {
  id                        Int      @id @default(1)
  memberVideoSermonsEnabled Boolean  @default(false)
  updatedAt                 DateTime @updatedAt
}

model SermonDocument {
  id           Int      @id @default(autoincrement())
  sermonId     Int
  filePath     String
  originalName String
  createdAt    DateTime @default(now())

  sermon Sermon @relation(fields: [sermonId], references: [id], onDelete: Cascade)
}

model ListeningSession {
  id                   Int      @id @default(autoincrement())
  userId               Int
  sermonId             Int
  progressSeconds      Int      @default(0)
  completed            Boolean  @default(false)
  completedAt          DateTime?
  mediaDurationSeconds Int?
  updatedAt            DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sermon Sermon @relation(fields: [sermonId], references: [id], onDelete: Cascade)

  @@unique([userId, sermonId])
}

model PasswordResetCode {
  id         Int       @id @default(autoincrement())
  userId     Int
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
